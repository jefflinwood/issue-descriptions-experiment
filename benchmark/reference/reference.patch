+def _reorder_prefill(order_id):
+    """Form defaults for reordering ``order_id``, or None. Never creates an order.
+
+    Quantities come from the original order's active products (repeated lines are
+    summed); inactive products are reported instead. Prices are not carried over:
+    the normal submission prices every line at the current product price. Dates
+    and notes are left for the person placing the order.
+    """
+    if not order_id:
+        return None
+    source = Order.query.get_or_404(order_id)
+    if not current_user.is_staff and source.customer_id != current_user.customer_id:
+        abort(403)
+    quantities, skipped = {}, []
+    for item in source.items:
+        if item.product.active:
+            quantities[item.product_id] = quantities.get(item.product_id, 0) + item.quantity
+        elif item.product.name not in skipped:
+            skipped.append(item.product.name)
+    method = source.shipments[0].method if source.shipments else None
+    return dict(order=source, quantities=quantities, skipped=skipped, customer_id=source.customer_id,
+                shipping_method=method)
+
+
