diff --git a/tests/test_reorder.py b/tests/test_reorder.py
new file mode 100644
index 0000000..714e36d
--- /dev/null
+++ b/tests/test_reorder.py
@@ -0,0 +1,105 @@
+from datetime import date, timedelta
+from decimal import Decimal
+import re
+
+from app import db
+from app.models import Order, OrderItem, Product
+
+
+def prefilled(response):
+    """Product id → quantity as submitted by the rendered new-order form."""
+    html = response.data.decode()
+    ids = re.findall(r'name="product_id" value="(\d+)"', html)
+    quantities = re.findall(r'name="quantity" min="0" value="(\d+)"', html)
+    return {int(i): int(q) for i, q in zip(ids, quantities)}
+
+
+def test_reorder_prefills_without_creating_an_order(app, client, login):
+    login("customer@example.test")
+    order_id = app.config["TEST_IDS"]["own_order"]
+    with app.app_context():
+        before = Order.query.count()
+
+    response = client.get(f"/orders/new?reorder={order_id}")
+
+    assert response.status_code == 200
+    assert prefilled(response) == {app.config["TEST_IDS"]["product"]: 2}
+    with app.app_context():
+        assert Order.query.count() == before
+
+
+def test_order_page_links_to_reorder(app, client, login):
+    login("customer@example.test")
+    order_id = app.config["TEST_IDS"]["own_order"]
+
+    response = client.get(f"/orders/{order_id}")
+
+    assert f"/orders/new?reorder={order_id}" in response.data.decode()
+
+
+def test_customer_cannot_reorder_another_customers_order(app, client, login):
+    login("customer@example.test")
+
+    response = client.get(f"/orders/new?reorder={app.config['TEST_IDS']['other_order']}")
+
+    assert response.status_code == 403
+
+
+def test_staff_reorder_preselects_account(app, client, login):
+    login("staff@example.test")
+
+    response = client.get(f"/orders/new?reorder={app.config['TEST_IDS']['other_order']}")
+
+    assert re.search(r'<option value="\d+" data-customer-type="wholesale" selected>Southside Cafe',
+                     response.data.decode())
+
+
+def test_inactive_products_are_skipped_and_named(app, client, login):
+    with app.app_context():
+        retired = Product(sku="OLD-1", name="Retired Blend", origin="Kenya", roast_level="light",
+                          wholesale_price_per_case=Decimal("90.00"), retail_price_per_bag=Decimal("12.00"),
+                          active=False)
+        order = db.session.get(Order, app.config["TEST_IDS"]["own_order"])
+        order.items.append(OrderItem(product=retired, quantity=1, unit_price=Decimal("90.00")))
+        db.session.commit()
+    login("customer@example.test")
+
+    response = client.get(f"/orders/new?reorder={app.config['TEST_IDS']['own_order']}")
+
+    assert "Retired Blend" in response.data.decode()
+    assert "no longer available" in response.data.decode()
+    assert prefilled(response) == {app.config["TEST_IDS"]["product"]: 2}
+
+
+def test_submitted_reorder_uses_current_prices(app, client, login):
+    with app.app_context():
+        db.session.get(Product, app.config["TEST_IDS"]["product"]).wholesale_price_per_case = Decimal("120.00")
+        db.session.commit()
+    login("customer@example.test")
+    form = prefilled(client.get(f"/orders/new?reorder={app.config['TEST_IDS']['own_order']}"))
+
+    response = client.post("/orders/new", data={
+        "customer_id": _northside_id(app), "product_id": list(form), "quantity": list(form.values()),
+        "shipping_method": "ups", "due_date": (date.today() + timedelta(days=7)).isoformat()})
+
+    assert response.status_code == 302
+    with app.app_context():
+        newest = Order.query.order_by(Order.id.desc()).first()
+        assert newest.id != app.config["TEST_IDS"]["own_order"]
+        assert [(i.quantity, i.unit_price) for i in newest.items] == [(2, Decimal("120.00"))]
+        original = db.session.get(Order, app.config["TEST_IDS"]["own_order"])
+        assert [i.unit_price for i in original.items] == [Decimal("100.00")]
+
+
+def test_reorder_leaves_dates_blank(app, client, login):
+    login("staff@example.test")
+
+    html = client.get(f"/orders/new?reorder={app.config['TEST_IDS']['other_order']}").data.decode()
+
+    assert re.search(r'id="due_date" name="due_date" type="date" required>', html)
+    assert re.search(r'id="requested_ship_date" name="requested_ship_date" type="date">', html)
+
+
+def _northside_id(app):
+    with app.app_context():
+        return db.session.get(Order, app.config["TEST_IDS"]["own_order"]).customer_id
