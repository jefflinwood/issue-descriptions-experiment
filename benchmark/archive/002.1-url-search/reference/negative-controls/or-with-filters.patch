diff --git a/tests/test_order_search.py b/tests/test_order_search.py
new file mode 100644
index 0000000..555a0f8
--- /dev/null
+++ b/tests/test_order_search.py
@@ -0,0 +1,102 @@
+from datetime import datetime
+import re
+
+from app import db
+from app.models import Customer, Order
+
+
+def _add_order(number, customer_name, status="pending", day=3):
+    customer = Customer.query.filter_by(name=customer_name).first()
+    if customer is None:
+        customer = Customer(name=customer_name, type="retail")
+        db.session.add(customer)
+    order = Order(order_number=number, customer=customer, order_type=customer.type,
+                  status=status, order_date=datetime(2026, 9, day, 9, 0))
+    db.session.add(order)
+    db.session.commit()
+
+
+def listed(response):
+    """Order numbers linked from the orders table, ignoring echoed search text."""
+    return set(re.findall(r'href="/orders/\d+">([^<]+)</a>', response.data.decode()))
+
+
+def test_staff_search_matches_order_number_case_insensitively(client, login):
+    login("staff@example.test")
+
+    response = client.get("/orders/?q=  ws-test-001 ")
+
+    assert "WS-TEST-001" in listed(response)
+    assert "WS-TEST-002" not in listed(response)
+
+
+def test_staff_search_matches_account_name(client, login):
+    login("staff@example.test")
+
+    response = client.get("/orders/?q=southside")
+
+    assert "WS-TEST-002" in listed(response)
+    assert "WS-TEST-001" not in listed(response)
+
+
+def test_empty_search_shows_all_orders(client, login):
+    login("staff@example.test")
+
+    response = client.get("/orders/?q=%20%20")
+
+    assert "WS-TEST-001" in listed(response)
+    assert "WS-TEST-002" in listed(response)
+
+
+def test_search_combines_with_status_filter(app, client, login):
+    login("staff@example.test")
+
+    response = client.get("/orders/?status=confirmed&q=cafe")
+
+    assert "WS-TEST-002" in listed(response)
+    assert "WS-TEST-001" not in listed(response)
+
+
+def test_search_treats_wildcards_literally(app, client, login):
+    with app.app_context():
+        _add_order("RT-50%-OFF", "Percent Shopper")
+    login("staff@example.test")
+
+    percent = client.get("/orders/?q=%25")
+    underscore = client.get("/orders/?q=_")
+
+    assert "RT-50%-OFF" in listed(percent)
+    assert "WS-TEST-001" not in listed(percent)
+    assert "WS-TEST-001" not in listed(underscore)
+
+
+def test_customer_search_stays_within_own_orders(client, login):
+    login("customer@example.test")
+
+    other = client.get("/orders/?q=WS-TEST-002")
+    by_name = client.get("/orders/?q=southside")
+    own = client.get("/orders/?q=001")
+
+    assert "WS-TEST-002" not in listed(other)
+    assert "WS-TEST-002" not in listed(by_name)
+    assert "WS-TEST-001" in listed(own)
+
+
+def test_search_form_and_filter_links_keep_state(client, login):
+    login("staff@example.test")
+
+    response = client.get("/orders/?status=pending&q=north%22")
+    page = response.data.decode()
+
+    assert 'name="q"' in page
+    assert 'value="north&#34;"' in page
+    assert 'name="status" value="pending"' in page
+    assert "type=retail&amp;q=north%22" in page or "q=north%22&amp;type=retail" in page
+
+
+def test_search_without_matches_shows_empty_state(client, login):
+    login("staff@example.test")
+
+    response = client.get("/orders/?q=no-such-order")
+
+    assert b"No orders match" in response.data
